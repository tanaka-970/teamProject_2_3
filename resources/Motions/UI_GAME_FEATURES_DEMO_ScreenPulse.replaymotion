MOTION "Demo Screen VHS Pulse"
MOTION_VERSION 4
DURATION 3

TRACK "VHS Intensity"
OBJECT 1
BINDING_ORIGIN 0
BINDING_PATH ""
COMPONENT_TYPE "ScreenEffectStackComponent"
COMPONENT_INDEX 0
PROPERTY "effects[0].intensity"
VALUE_TYPE FLOAT
ENABLED 1
BLEND_MODE Override
KEY 0 FLOAT 0.12 EASING Linear
KEY 1.5 FLOAT 0.55 EASING EaseInOutQuad
KEY 3 FLOAT 0.12 EASING EaseInOutQuad
END_TRACK
