MOTION "Persona Result Screen"
MOTION_VERSION 4
DURATION 1.1

TRACK "Wipe"
OBJECT 1
BINDING_ORIGIN 1
BINDING_PATH ""
COMPONENT_TYPE "ScreenEffectStackComponent"
COMPONENT_INDEX 0
PROPERTY "effects[8].progress"
VALUE_TYPE FLOAT
ENABLED 1
BLEND_MODE Override
KEY 0 FLOAT 0 EASING Linear
KEY 0.55 FLOAT 1 EASING EaseInOutCubic
KEY 1.1 FLOAT 1 EASING Linear
END_TRACK

TRACK "帯を出す"
OBJECT 1
BINDING_ORIGIN 1
BINDING_PATH ""
COMPONENT_TYPE "ScreenEffectStackComponent"
COMPONENT_INDEX 0
PROPERTY "effects[7].intensity"
VALUE_TYPE FLOAT
ENABLED 1
BLEND_MODE Override
KEY 0 FLOAT 0 EASING Linear
KEY 0.32 FLOAT 1 EASING EaseOutBack
KEY 1.1 FLOAT 1 EASING Linear
END_TRACK

TRACK "帯を狭める"
OBJECT 1
BINDING_ORIGIN 1
BINDING_PATH ""
COMPONENT_TYPE "ScreenEffectStackComponent"
COMPONENT_INDEX 0
PROPERTY "effects[7].radius"
VALUE_TYPE FLOAT
ENABLED 1
BLEND_MODE Override
KEY 0 FLOAT 1.78 EASING Linear
KEY 0.32 FLOAT 2.4 EASING EaseOutBack
KEY 1.1 FLOAT 2.4 EASING Linear
END_TRACK
