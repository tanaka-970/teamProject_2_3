MOTION "Persona Hit Shake"
MOTION_VERSION 4
DURATION 0.3

TRACK "Shake"
OBJECT 1
BINDING_ORIGIN 1
BINDING_PATH ""
COMPONENT_TYPE "ScreenEffectStackComponent"
COMPONENT_INDEX 0
PROPERTY "effects[6].intensity"
VALUE_TYPE FLOAT
ENABLED 1
BLEND_MODE Override
KEY 0 FLOAT 0 EASING Linear
KEY 0.04 FLOAT 0.8 EASING EaseOutCubic
KEY 0.3 FLOAT 0 EASING EaseInQuad
END_TRACK

TRACK "ChromaticAberration"
OBJECT 1
BINDING_ORIGIN 1
BINDING_PATH ""
COMPONENT_TYPE "ScreenEffectStackComponent"
COMPONENT_INDEX 0
PROPERTY "effects[3].intensity"
VALUE_TYPE FLOAT
ENABLED 1
BLEND_MODE Override
KEY 0 FLOAT 0 EASING Linear
KEY 0.04 FLOAT 0.35 EASING EaseOutCubic
