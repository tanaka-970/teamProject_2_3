MOTION "Status To Item"
MOTION_VERSION 4
DURATION 0.200000

TRACK "Old ribbon exits"
OBJECT 1
BINDING_ORIGIN 3
BINDING_PATH "OldRibbon"
COMPONENT_TYPE "RectTransformComponent"
COMPONENT_INDEX 0
PROPERTY "anchored_position"
VALUE_TYPE VEC2
ENABLED 1
BLEND_MODE Override
KEY 0.000000 VEC2 0.000000 0.000000 EASING Linear
KEY 0.200000 VEC2 -260.000000 18.000000 EASING EaseInCubic
END_TRACK

TRACK "Old ribbon squash"
OBJECT 1
BINDING_ORIGIN 3
BINDING_PATH "OldRibbon"
COMPONENT_TYPE "RectTransformComponent"
COMPONENT_INDEX 0
PROPERTY "scale"
VALUE_TYPE VEC2
ENABLED 1
BLEND_MODE Override
KEY 0.000000 VEC2 1.000000 1.000000 EASING Linear
KEY 0.200000 VEC2 0.720000 0.780000 EASING EaseInQuad
END_TRACK

TRACK "New ribbon enters"
OBJECT 1
BINDING_ORIGIN 3
BINDING_PATH "NewRibbon"
COMPONENT_TYPE "RectTransformComponent"
COMPONENT_INDEX 0
PROPERTY "anchored_position"
VALUE_TYPE VEC2
ENABLED 1
BLEND_MODE Override
KEY 0.000000 VEC2 850.000000 -10.000000 EASING Linear
KEY 0.144000 VEC2 -35.000000 5.000000 EASING EaseOutBack
KEY 0.200000 VEC2 0.000000 0.000000 EASING EaseOutCubic
END_TRACK

TRACK "New ribbon pop"
OBJECT 1
BINDING_ORIGIN 3
BINDING_PATH "NewRibbon"
COMPONENT_TYPE "RectTransformComponent"
COMPONENT_INDEX 0
PROPERTY "scale"
VALUE_TYPE VEC2
ENABLED 1
BLEND_MODE Override
KEY 0.000000 VEC2 0.580000 0.700000 EASING Linear
KEY 0.144000 VEC2 1.080000 1.040000 EASING EaseOutBack
KEY 0.200000 VEC2 1.000000 1.000000 EASING EaseOutCubic
END_TRACK

TRACK "Ribbon shape morph"
OBJECT 1
BINDING_ORIGIN 3
BINDING_PATH "NewRibbon"
COMPONENT_TYPE "UIShapeComponent"
COMPONENT_INDEX 0
PROPERTY "point[3].position"
VALUE_TYPE VEC2
ENABLED 1
BLEND_MODE Override
KEY 0.000000 VEC2 0.520000 0.160000 EASING Linear
KEY 0.100000 VEC2 0.460000 0.340000 EASING EaseOutQuad
KEY 0.200000 VEC2 0.520000 0.160000 EASING EaseInOutQuad
END_TRACK
