MOTION "Persona Item Idle"
MOTION_VERSION 4
DURATION 3.000000

TRACK "Whole float"
OBJECT 1
BINDING_ORIGIN 3
BINDING_PATH "ItemCharacter"
COMPONENT_TYPE "RectTransformComponent"
COMPONENT_INDEX 0
PROPERTY "anchored_position"
VALUE_TYPE VEC2
ENABLED 1
BLEND_MODE Override
KEY 0.000000 VEC2 0.000000 0.000000 EASING Linear
KEY 0.750000 VEC2 4.000000 5.000000 EASING EaseInOutQuad
KEY 1.500000 VEC2 -2.000000 -4.000000 EASING EaseInOutQuad
KEY 2.250000 VEC2 3.000000 3.000000 EASING EaseInOutQuad
KEY 3.000000 VEC2 0.000000 0.000000 EASING EaseInOutQuad
END_TRACK

